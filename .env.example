# Скопировать в .env и заполнить. Файл .env в репозиторий не попадает.

# Токен бота из @BotFather
BOT_TOKEN=

# Закрытая группа очереди, куда приходят карточки заявок (D9).
# Значение отрицательное, вида -1001234567890. Бот должен быть администратором:
# без этого он не сможет править карточку при смене статуса.
QUEUE_CHAT_ID=

# Отделы для анкеты, через запятую. Обязательное поле: без справочника
# анкета не соберётся (D10).
DEPARTMENTS=Бухгалтерия,Отдел кадров,Продажи,Логистика

# Необязательные — значения по умолчанию из раздела 2.2 TODO.md
# DB_PATH=itsm.db
# BUFFER_SECONDS=45
# RATE_LIMIT_PER_HOUR=5
# DEDUP_WINDOW_MINUTES=10
# CARD_TEXT_LIMIT=1200
